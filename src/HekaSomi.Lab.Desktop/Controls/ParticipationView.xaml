<UserControl x:Class="HekaSomi.Lab.Desktop.Controls.ParticipationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Background="#E2EFEC" Margin="0">
   <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}"/>
   <DockPanel Margin="16,8">
    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/>
    <TextBlock Text="{Binding Message}" VerticalAlignment="Center"/>
   </DockPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="24">
    <TextBlock Text="Learn about AI by taking part." Style="{StaticResource Heading}"/>
    <TextBlock Text="Compare your choices with your personality model, try another agent, and inspect what changed." Margin="0,0,0,16"/>
    <Border Style="{StaticResource Card}">
     <StackPanel IsEnabled="{Binding IsIdle}">
      <TextBlock Text="1. Take a test" Style="{StaticResource Section}"/>
      <WrapPanel>
       <Button Content="Refresh profiles and results" Command="{Binding RefreshCommand}"/>
       <Button Content="Load practice test" Command="{Binding LoadPilotCommand}"/>
       <Button Content="Import test" Command="{Binding ImportTestCommand}"/>
      </WrapPanel>
      <TextBlock Text="Approved profile" Style="{StaticResource Label}"/>
      <ComboBox ItemsSource="{Binding Constructs}" SelectedItem="{Binding SelectedConstruct}" DisplayMemberPath="Name" AutomationProperties.Name="Approved personality profile"/>
      <TextBlock Text="{Binding SelectedConstruct.Key}" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="{Binding TestTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
      <TextBlock Text="The included questions are a practice instrument. There are no right or wrong personality choices. Use new, independently held-out questions for formal evaluation." Foreground="{StaticResource Muted}"/>
      <ItemsControl ItemsSource="{Binding Questions}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Margin="0,12,0,0">
          <TextBlock Text="{Binding Item.Question}"/>
          <ComboBox ItemsSource="{Binding Item.Options}" SelectedItem="{Binding SelectedAnswer}" AutomationProperties.Name="{Binding Item.Question}"/>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <CheckBox Content="These questions and my answers were not used to build this profile." IsChecked="{Binding HeldOutAttested}"/>
      <Button Content="Seal my answers" Command="{Binding SealCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel IsEnabled="{Binding IsIdle}">
      <TextBlock Text="2. Compare an agent" Style="{StaticResource Section}"/>
      <TextBlock Text="Sealed test session" Style="{StaticResource Label}"/>
      <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Label" AutomationProperties.Name="Sealed test session"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Provider or personal agent" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Name" AutomationProperties.Name="Agent provider"/>
        <TextBlock Text="{Binding SelectedProvider.Note}" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="Model ID (or agent name for manual comparisons)" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model or agent identity"/>
        <TextBlock Text="Profile condition" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" AutomationProperties.Name="Profile condition"/>
        <TextBlock Text="Compare Neutral or StyleOnly with Combined using the same model and test. InterviewOnly uses reviewed claims; questionnaire conditions use raw domain scores." Foreground="{StaticResource Muted}" Margin="0,8"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="API protocol" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}" AutomationProperties.Name="API protocol"/>
        <TextBlock Text="Endpoint" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Provider endpoint"/>
        <TextBlock Text="Environment variable containing your API key" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding CredentialVariable, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API key environment variable name"/>
        <TextBlock Text="Enter the variable name here, not the key. Set it in Windows before opening Lab. Subscription credentials are not developer API keys." Foreground="{StaticResource Muted}" Margin="0,8"/>
        <WrapPanel>
         <TextBlock Text="Seconds per question" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBox Text="{Binding TimeoutSeconds}" Width="70"/>
         <TextBlock Text="Output token cap" VerticalAlignment="Center" Margin="12,0,8,0"/>
         <TextBox Text="{Binding MaxOutputTokens}" Width="80"/>
        </WrapPanel>
       </StackPanel>
      </Grid>
      <Button Content="Preview profile context" Command="{Binding PreviewContextCommand}" HorizontalAlignment="Left"/>
      <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Profile context preview"/>
      <CheckBox IsChecked="{Binding SharingConfirmed}">
       <TextBlock Text="I reviewed the selected profile context and allow it and the test questions to be sent to this agent. Remote API calls may incur charges."/>
      </CheckBox>
      <WrapPanel>
       <Button Content="Run / resume API comparison" Command="{Binding CompareCommand}" Style="{StaticResource Primary}"/>
       <Button Content="Export agent task" Command="{Binding ExportTaskCommand}"/>
       <Button Content="Import agent answers" Command="{Binding ImportAnswersCommand}"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="3. See where the answers match" Style="{StaticResource Section}"/>
      <TextBlock Text="Match rate = matching choices ÷ all eligible questions. Coverage = valid agent answers ÷ all questions. Failures, abstentions and missing answers do not disappear from the denominator." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
      <DataGrid ItemsSource="{Binding Dashboard}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True" Height="260" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Personality comparison dashboard">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="150"/>
        <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="110"/>
        <DataGridTextColumn Header="Match" Binding="{Binding Match}" Width="110"/>
        <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="85"/>
        <DataGridTextColumn Header="Done" Binding="{Binding Progress}" Width="60"/>
        <DataGridTextColumn Header="Source" Binding="{Binding Origin}" Width="170"/>
        <DataGridTextColumn Header="Evidence route" Binding="{Binding Mode}" Width="135"/>
        <DataGridTextColumn Header="Test" Binding="{Binding Test}" Width="*" MinWidth="160"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding Comparison}" Margin="0,14"/>
      <TextBlock Text="Selected test: your choices and the agent's responses" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <DataGrid ItemsSource="{Binding QuestionResults}" IsReadOnly="True" Height="240" AutomationProperties.Name="Question by question comparison">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Question" Binding="{Binding Question}" Width="*" MinWidth="240"/>
        <DataGridTextColumn Header="Your choice" Binding="{Binding YourChoice}" Width="200"/>
        <DataGridTextColumn Header="Agent choice" Binding="{Binding AgentChoice}" Width="200"/>
        <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="90"/>
        <DataGridTextColumn Header="Match" Binding="{Binding Match}" Width="60"/>
       </DataGrid.Columns>
      </DataGrid>
      <Border Background="#E2EFEC" CornerRadius="8" Padding="16"><TextBlock Text="{Binding GlobalAverage}" FontSize="17" FontWeight="SemiBold"/></Border>
      <TextBlock Text="These are observations of specific tests, not a diagnosis or a percentage of your personality captured. A personal agent's existing memories can affect its answers; compare that route separately." Foreground="{StaticResource Muted}" Margin="0,12"/>
      <WrapPanel IsEnabled="{Binding IsIdle}">
       <Button Content="Export selected comparison" Command="{Binding ExportReportCommand}"/>
       <Button Content="Import platform report" Command="{Binding ImportReportCommand}"/>
       <Button Content="Remove imported reports" Command="{Binding DeleteImportsCommand}"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel IsEnabled="{Binding IsIdle}">
      <TextBlock Text="Platform tests and game activity" Style="{StaticResource Section}"/>
      <TextBlock Text="{Binding EventSummary}"/>
      <DataGrid ItemsSource="{Binding GameEvents}" IsReadOnly="True" Height="180" Margin="0,12" AutomationProperties.Name="Recorded platform game events">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="*"/>
        <DataGridTextColumn Header="Activity" Binding="{Binding Kind}" Width="170"/>
        <DataGridTextColumn Header="Player" Binding="{Binding ActorKind}" Width="80"/>
        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
        <DataGridTextColumn Header="Milliseconds" Binding="{Binding DurationMs, StringFormat=F0}" Width="110"/>
        <DataGridTextColumn Header="When" Binding="{Binding OccurredAt}" Width="220"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Platform address" Style="{StaticResource Label}"/>
      <TextBox Text="{Binding PlatformUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="HekaSomi platform address"/>
      <TextBlock Text="Online sync needs the new website endpoints and a read-only token in HEKASOMI_LAB_TOKEN. Lab does not upload your local answers. A global average appears only after the platform returns a matching cohort with enough owners." Foreground="{StaticResource Muted}" Margin="0,8"/>
      <CheckBox Content="I verified this platform address and authorize sending its read-only Lab token." IsChecked="{Binding PlatformConfirmed}"/>
      <WrapPanel>
       <Button Content="Fetch platform report" Command="{Binding FetchReportCommand}"/>
       <Button Content="Fetch matching global average" Command="{Binding FetchGlobalCommand}"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
